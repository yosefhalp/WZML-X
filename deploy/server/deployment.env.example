# מפת פריסה גנרית. יש להעתיק אותה מחוץ ל-Git ולהתאים לשרת היעד.
DEPLOYMENT_VERSION=1
DEPLOYMENT_NAME=wzmlx-primary
DEPLOYMENT_ROOT=/srv/wzmlx
DEPLOYMENT_SHARED_DIR=/srv/wzmlx/shared
DEPLOYMENT_RELEASES_DIR=/srv/wzmlx/releases
DEPLOYMENT_BACKUP_DIR=/srv/wzmlx/backups
DEPLOYMENT_CURRENT_LINK=/srv/wzmlx/current
DEPLOYMENT_STATE_FILE=/srv/wzmlx/shared/deployment-state.json
DEPLOYMENT_LOCK_FILE=/run/lock/wzmlx-deploy.lock
DEPLOYMENT_COMPOSE_PROJECT=wzmlx
DEPLOYMENT_COMPOSE_FILE=docker-compose.server.yml
DEPLOYMENT_SERVICE=wzmlx
DEPLOYMENT_HEALTH_URL=http://127.0.0.1:8080/health
DEPLOYMENT_KEEP_RELEASES=2

# שמות ופורטים משתנים מאפשרים כמה פריסות מבודדות על אותו שרת.
WZMLX_CONTAINER_NAME=wzmlx-hebrew-bot
WZMLX_IMAGE=wzmlx-hebrew:server
WZMLX_HOST_PORT=8080
WZMLX_MONGO_CONTAINER_NAME=wzmlx-mongodb
WZMLX_MONGO_PORT=27017
WZMLX_MONGO_VOLUME_NAME=wzmlx-mongo-data
WZMLX_BOT_API_CONTAINER_NAME=tg-bot-api
WZMLX_BOT_API_MODE=external
WZMLX_BOT_API_BASE_URL=http://127.0.0.1:8081
WZMLX_BOT_API_PORT=8081
WZMLX_BOT_API_VOLUME_NAME=wzmlx-telegram-bot-api-data
WZMLX_NETWORK_NAME=wzmlx-internal

# הסודות עצמם אינם נמצאים בקובץ הזה; נשמרים כאן רק הנתיבים אליהם.
WZMLX_CONFIG_PATH=/srv/wzmlx/shared/secrets/config.py
WZMLX_ENV_PATH=/srv/wzmlx/shared/secrets/.env.server
WZMLX_MONGO_ENV_PATH=/srv/wzmlx/shared/secrets/.env.mongo
WZMLX_BOT_API_ENV_PATH=/srv/wzmlx/shared/secrets/telegram-bot-api.env
WZMLX_ACCOUNTS_DIR=/srv/wzmlx/shared/accounts
WZMLX_DOWNLOADS_DIR=/srv/wzmlx/shared/downloads
WZMLX_CONTROL_DIR=/srv/wzmlx/shared/runtime/control

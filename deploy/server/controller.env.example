# הקובץ הזה נשמר במחשב המפעיל בלבד ואינו עולה ל-Git.
CONTROLLER_PROFILE_VERSION=1
CONTROLLER_NAME=wzmlx-primary
SSH_HOST=server.example.net
SSH_PORT=22
SSH_USER=deploy
SSH_IDENTITY_FILE=C:/Users/example/.ssh/wzmlx_ed25519
SSH_KNOWN_HOSTS_FILE=C:/Users/example/.ssh/known_hosts
SSH_HOST_KEY_SHA256=SHA256:replace-with-real-fingerprint
LOCAL_DEPLOYMENT_ENV_FILE=C:/Users/example/.config/wzmlx/deployments/primary.deployment.env
REMOTE_DEPLOYMENT_ENV=/etc/wzmlx/deployment.env
REMOTE_CONTROLLER_DIR=/var/lib/wzmlx/controller
REPOSITORY_URL=https://github.com/yosefhalp/WZML-X.git
REPOSITORY_BRANCH=wzv3
